# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Except Tesla's Fleet API public key, which must be served publicly from this
# domain so Tesla can verify the homelab's Home Assistant integration. Public
# by design; the private half never leaves Home Assistant.
!public/.well-known/appspecific/com.tesla.3p.public-key.pem

# claude code
.claude/*
!.claude/settings.json
!.claude/hooks/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel
.cache/

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# fold-check screenshots (scripts/fold-check.mjs)
/fold-screenshots
/.lighthouseci
